{
  "build_override_patterns": [],
  "documentation_patterns": ["*.md", "**/*.md"],
  "documentation_asset_patterns": [
    "docs/*.gif",
    "docs/**/*.gif",
    "docs/*.jpeg",
    "docs/**/*.jpeg",
    "docs/*.jpg",
    "docs/**/*.jpg",
    "docs/*.png",
    "docs/**/*.png",
    "docs/*.svg",
    "docs/**/*.svg",
    "docs/*.webp",
    "docs/**/*.webp"
  ],
  "ignore_build_patterns": [
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/dependabot.yml",
    ".github/pull_request_template.md",
    "CODE_OF_CONDUCT*",
    "CONTRIBUTING.md",
    "CONTRIBUTING_ZH.md",
    "COPYING*",
    "LICENSE",
    "LICENSE.*",
    "SECURITY.md",
    "SECURITY_ZH.md",
    "SUPPORT.md",
    "SUPPORT_ZH.md"
  ],
  "firmware_patterns": ["Firmware/**", "firmware/**"],
  "esp_idf_shared_patterns": ["config/**"],
  "arduino_shared_patterns": ["examples/arduino/libraries/**"],
  "esp_idf_global_patterns": [],
  "arduino_global_patterns": [],
  "global_build_patterns": [
    ".github/**",
    "scripts/**",
    "tests/**",
    "ci-routing-config.json",
    "markdown-audit-config.json"
  ]
}
